{
  "name": "dsh-memory-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Portable DSH long-term memory host and settings UI",
  "workspaces": [
    "packages/dsh-memory",
    "packages/dsh-memory-ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "js-yaml": "4.3.1",
    "react": "18.2.0"
  },
  "scripts": {
    "scan:secrets": "zsh tools/secret-scan.sh",
    "test:public-tree": "zsh tests/test_public_tree.sh",
    "test:memory": "zsh tests/run-memory-tests.sh",
    "test:guards": "zsh tests/test_release_guards.sh",
    "test": "npm run scan:secrets && npm run test:public-tree && npm run test:memory && npm run test:guards"
  }
}
