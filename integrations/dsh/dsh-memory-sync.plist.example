<?xml version="1.0" encoding="UTF-8"?>
<!-- The sync wrapper discovers a local Node runtime even under launchd's
     minimal PATH; no interactive shell profile is required. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dsh.memory-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>mkdir -p "$HOME/.local/share/dsh-memory/logs" &amp;&amp; DSH_HOME="$HOME/.dsh" DSH_MEMORY_ROOT="$HOME/.dsh/storages/memory" exec "$HOME/.local/share/dsh-memory/integrations/dsh/dsh-memory-sync" &gt;&gt; "$HOME/.local/share/dsh-memory/logs/memory-sync.log" 2&gt;&amp;1</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
