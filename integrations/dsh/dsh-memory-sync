#!/bin/zsh
# dsh-memory-sync: transactional, headless memory consolidation.
#
# v0.3: headless DSH only ever sees an isolated staging worktree. The host
# verifies the staged diff and applies it to the live memory root with its own
# Git commits (recovery + apply), records a run journal, and only then advances
# the .last-sync watermark. A host-side operation lock serializes sync runs and
# an active-run record lets an interrupted run be recovered on the next sync.
# A --dry-run flag reports the candidate diff without touching the live root,
# the journal, the lock, or Git.
# Zero-change runs journal a no_change record and advance the watermark so
# the same candidate window is never rescanned; dry-run and preview runs
# remain side-effect free (no journal record, no watermark move).
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
REPOSITORY_ROOT="$(cd -- "$SCRIPT_DIR/../.." 2>/dev/null && pwd -P)"
SYNC_APPLY="${DPSK_MEMORY_SYNC_HELPER:-$REPOSITORY_ROOT/packages/dsh-memory/lib/sync-apply.py}"
DSH_HOME="${DSH_HOME:-${HOME:?HOME is required}/.dsh}"
DSH_MEMORY_ROOT="${DSH_MEMORY_ROOT:-$DSH_HOME/storages/memory}"
MARKER="$DSH_MEMORY_ROOT/.last-sync"
PENDING_CANDIDATES="$DSH_MEMORY_ROOT/.sync/pending-candidates.json"
DSH_BIN="${DSH_BIN:-dsh}"
DSH_PERMISSION_MODE="${DSH_PERMISSION_MODE:-workspace-write}"
SYNC_POLICY_VERSION="${DSH_MEMORY_SYNC_POLICY_VERSION:-v0.8.2}"
MAX_CANDIDATE_SESSIONS="${DSH_MEMORY_MAX_CANDIDATE_SESSIONS:-10}"
MAX_CANDIDATE_BYTES="${DSH_MEMORY_MAX_CANDIDATE_BYTES:-8388608}"
RETRY_COOLDOWN_SECONDS="${DSH_MEMORY_RETRY_COOLDOWN_SECONDS:-3600}"
# These are host-lifecycle metrics, never numbers inferred from the model's
# natural-language report. Candidates pass the watermark and one-hour idle
# guards; a successful headless invocation processes every candidate it receives.
CANDIDATE_SESSIONS=0
PROCESSED_SESSIONS=0
SKIPPED_SESSIONS=0
CANDIDATE_BYTES=0
CANDIDATE_DIGEST=""
CANDIDATE_MANIFEST_TMP=""
CANDIDATE_TRUNCATED=0
CANDIDATE_LIMIT_ERROR=""

DRY_RUN=0
PREVIEW_MODE=0
APPLY_PREVIEW=""
DISCARD_PREVIEW=""
JSON_OUTPUT=0
RETRY_FAILED=0
PREVIEW_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --preview)
      PREVIEW_MODE=1
      PREVIEW_ID="${2:-}"
      [[ -n "$PREVIEW_ID" ]] || { print -u2 -- "dsh-memory-sync: --preview requires a preview id"; exit 2; }
      shift 2
      ;;
    --apply-preview)
      APPLY_PREVIEW="${2:-}"
      [[ -n "$APPLY_PREVIEW" ]] || { print -u2 -- "dsh-memory-sync: --apply-preview requires a preview id"; exit 2; }
      shift 2
      ;;
    --discard-preview)
      DISCARD_PREVIEW="${2:-}"
      [[ -n "$DISCARD_PREVIEW" ]] || { print -u2 -- "dsh-memory-sync: --discard-preview requires a preview id"; exit 2; }
      shift 2
      ;;
    --json) JSON_OUTPUT=1; shift ;;
    --retry-failed) RETRY_FAILED=1; shift ;;
    *) print -u2 -- "dsh-memory-sync: unexpected argument: $1"; exit 2 ;;
  esac
done
# The preview management modes are mutually exclusive with a normal sync.
if [[ "$DRY_RUN" == "1" && "$PREVIEW_MODE" == "1" ]]; then
  print -u2 -- "dsh-memory-sync: --dry-run and --preview are mutually exclusive"
  exit 2
fi
management_modes=0
[[ -n "$APPLY_PREVIEW" ]] && management_modes=$((management_modes + 1))
[[ -n "$DISCARD_PREVIEW" ]] && management_modes=$((management_modes + 1))
[[ "$PREVIEW_MODE" == "1" ]] && management_modes=$((management_modes + 1))
if [[ "$management_modes" -gt 1 ]]; then
  print -u2 -- "dsh-memory-sync: --preview/--apply-preview/--discard-preview are mutually exclusive"
  exit 2
fi

PYTHON_BIN="${DPSK_PYTHON3:-python3}"
command -v "$PYTHON_BIN" >/dev/null 2>&1 || { print -u2 -- "dsh-memory-sync: python3 is required"; exit 127; }

# launchd starts agents with a minimal PATH. The pinned DSH launcher is a
# `#!/usr/bin/env node` script, so make a discovered Node runtime available to
# the isolated child even when the LaunchAgent was not loaded from a shell
# that initialized nvm/Homebrew. Explicit PATH entries still win; this is only
# a fail-closed compatibility fallback for the local runtime.
resolve_node_executable() {
  setopt local_options null_glob numeric_glob_sort
  local candidate
  local version_major
  local i
  typeset -a nvm_candidates
  is_supported_node() {
    [[ -x "$1" ]] || return 1
    version_major="$("$1" --version 2>/dev/null | /usr/bin/sed -E 's/^v([0-9]+).*/\1/' || true)"
    [[ "$version_major" =~ '^[0-9]+$' ]] && (( version_major >= 22 ))
  }
  candidate="$(command -v node 2>/dev/null || true)"
  if [[ -n "$candidate" ]] && is_supported_node "$candidate"; then
    print -r -- "$candidate"
    return 0
  fi
  # Prefer stable system/Homebrew locations, then the numerically newest nvm
  # installation (v22 over an older v20, for example).
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
    if is_supported_node "$candidate"; then
      print -r -- "$candidate"
      return 0
    fi
  done
  nvm_candidates=("$HOME"/.nvm/versions/node/*/bin/node(N))
  for (( i=${#nvm_candidates}; i >= 1; i-- )); do
    candidate="${nvm_candidates[i]}"
    if is_supported_node "$candidate"; then
      print -r -- "$candidate"
      return 0
    fi
  done
  return 1
}

NODE_EXECUTABLE="$(resolve_node_executable || true)"
RUNTIME_PATH="${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
if [[ -n "$NODE_EXECUTABLE" ]]; then
  NODE_DIR="$(dirname -- "$NODE_EXECUTABLE")"
  case ":$RUNTIME_PATH:" in
    *":$NODE_DIR:"*) ;;
    *) RUNTIME_PATH="$NODE_DIR:$RUNTIME_PATH" ;;
  esac
fi

# In --json mode every progress line is suppressed from stdout so the single
# JSON document on stdout stays machine-parseable; diagnostics still go to stderr.
progress() {
  if [[ "$JSON_OUTPUT" != "1" ]]; then
    print -- "dsh-memory-sync: $*"
  fi
}

sync_apply() {
  /usr/bin/env -i \
    "HOME=${HOME:?HOME is required}" \
    "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}" \
    "TMPDIR=${TMPDIR:-/tmp}" \
    "$PYTHON_BIN" "$SYNC_APPLY" "$@"
}

json_error_code() {
  printf '%s' "$1" | "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin).get("error", {}).get("code", "sync-failed"))' 2>/dev/null || print -- "sync-failed"
}

write_failure_record() {
  local error_code="$1"
  local phase="$2"
  local error_payload="${3:-}"
  local error_id=""
  local first_path=""
  local second_path=""
  typeset -a detail_args
  detail_args=()
  if [[ -n "$error_payload" ]]; then
    error_id="$(printf '%s' "$error_payload" | "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin).get("error", {}).get("id", ""))' 2>/dev/null || true)"
    first_path="$(printf '%s' "$error_payload" | "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin).get("error", {}).get("first_path", ""))' 2>/dev/null || true)"
    second_path="$(printf '%s' "$error_payload" | "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin).get("error", {}).get("second_path", ""))' 2>/dev/null || true)"
    [[ -n "$error_id" ]] && detail_args+=(--error-id "$error_id")
    [[ -n "$first_path" ]] && detail_args+=(--first-path "$first_path")
    [[ -n "$second_path" ]] && detail_args+=(--second-path "$second_path")
  fi
  sync_apply journal --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" \
    --operation-name sync --status failed --started-at "$STARTED_AT" \
    --candidate-sessions "$CANDIDATE_SESSIONS" --processed-sessions "$PROCESSED_SESSIONS" \
    --skipped-sessions "$SKIPPED_SESSIONS" --changed-paths "${changed_paths:-}" \
    --error-code "$error_code" --phase "$phase" --candidate-digest "$CANDIDATE_DIGEST" \
    --sync-policy-version "$SYNC_POLICY_VERSION" "${detail_args[@]}" >/dev/null 2>&1 || true
  sync_apply write-failure-sentinel --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" \
    --error-code "$error_code" --phase "$phase" --candidate-digest "$CANDIDATE_DIGEST" \
    >/dev/null 2>&1 || true
}

candidate_digest() {
  local file
  if [[ "$#" -eq 0 ]]; then
    print -r -- "sha256:$(printf '' | shasum -a 256 | awk '{print $1}')"
    return
  fi
  for file in "$@"; do
    printf '%s  ' "$file"
    shasum -a 256 -- "$file" | awk '{print $1}'
  done | shasum -a 256 | awk '{print "sha256:" $1}'
}

candidate_file_digest() {
  shasum -a 256 -- "$1" | awk '{print $1}'
}

pending_candidate_lines() {
  [[ -f "$PENDING_CANDIDATES" ]] || return 0
  "$PYTHON_BIN" - "$PENDING_CANDIDATES" <<'PY'
import json
import pathlib
import sys

try:
    value = json.loads(pathlib.Path(sys.argv[1]).read_text())
except (OSError, UnicodeDecodeError, json.JSONDecodeError):
    raise SystemExit(0)
for path, digest in (value.get("entries") or {}).items():
    if isinstance(path, str) and isinstance(digest, str):
        print(f"{path}\t{digest}")
PY
}

pending_candidate_digest() {
  local candidate="$1"
  local digest="$2"
  [[ -f "$PENDING_CANDIDATES" ]] || return 1
  "$PYTHON_BIN" - "$PENDING_CANDIDATES" "$candidate" "$digest" <<'PY'
import json
import pathlib
import sys

try:
    value = json.loads(pathlib.Path(sys.argv[1]).read_text())
except (OSError, UnicodeDecodeError, json.JSONDecodeError):
    raise SystemExit(1)
raise SystemExit(0 if (value.get("entries") or {}).get(sys.argv[2]) == sys.argv[3] else 1)
PY
}

write_pending_candidates() {
  if [[ "$CANDIDATE_TRUNCATED" != "1" ]]; then
    [[ "$DRY_RUN" == "0" && "$PREVIEW_MODE" == "0" ]] && rm -f -- "$PENDING_CANDIDATES"
    return 0
  fi
  "$PYTHON_BIN" - "$PENDING_CANDIDATES" "${CANDIDATE_FILES[@]}" <<'PY'
import json
import os
import pathlib
import sys
import tempfile
import hashlib

state_path = pathlib.Path(sys.argv[1])
try:
    current = json.loads(state_path.read_text())
except (OSError, UnicodeDecodeError, json.JSONDecodeError):
    current = {}
entries = current.get("entries") if isinstance(current, dict) else {}
if not isinstance(entries, dict):
    entries = {}
for path in sys.argv[2:]:
    try:
        digest = hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()
    except OSError:
        continue
    entries[path] = digest
state_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=".pending-candidates.", dir=state_path.parent)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump({"schema_version": 1, "entries": entries}, handle, separators=(",", ":"))
        handle.write("\n")
    os.replace(temporary, state_path)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
}

memory_sync_disabled() {
  local settings="$DSH_HOME/settings.yaml"
  [[ -f "$settings" ]] || return 1
  /usr/bin/awk '
    BEGIN { disabled = 0; in_memory = 0 }
    /^memory:[[:space:]]*(#.*)?$/ { in_memory = 1; next }
    in_memory && /^[^[:space:]#]/ { in_memory = 0 }
    in_memory && /^[[:space:]]*enabled:[[:space:]]*false([[:space:]]*(#.*)?$)/ {
      disabled = 1
      exit
    }
    END { exit disabled ? 0 : 1 }
  ' "$settings"
}

# A disabled setting is a zero-side-effect stop: do not initialize storage,
# scan sessions, touch the marker, construct a prompt, or start DSH.
if memory_sync_disabled; then
  echo "dsh-memory-sync: memory.enabled is false; skipping sync."
  exit 0
fi

INITIALIZER="$SCRIPT_DIR/dsh-memory-init"
if [[ ! -x "$INITIALIZER" ]]; then
  print -u2 -- "dsh-memory-sync: initializer is not executable: $INITIALIZER"
  exit 127
fi

# Build a small, credential-free base environment before invoking any child.
# The initializer only needs local filesystem and Git access; provider values
# are intentionally unavailable until the final DSH process is started.
typeset -a BASE_ENV
BASE_ENV=(
  "HOME=${HOME:?HOME is required}"
  "DSH_HOME=$DSH_HOME"
  "DSH_MEMORY_ROOT=$DSH_MEMORY_ROOT"
  "PATH=$RUNTIME_PATH"
  "TMPDIR=${TMPDIR:-/tmp}"
  "LANG=${LANG:-C}"
)

typeset env_name
for env_name in ${(k)parameters}; do
  if [[ "$env_name" == LC_* && "${parameters[$env_name]}" == *export* ]]; then
    BASE_ENV+=("$env_name=${(P)env_name}")
  fi
done

/usr/bin/env -i "${BASE_ENV[@]}" "$INITIALIZER" >/dev/null

# --- Preview management modes (--apply-preview / --discard-preview) ---
# These are short host-side operations handled before any session scan: they
# do not start DSH or advance the watermark. --apply-preview acquires the
# operation lock so it cannot race a normal sync; --discard-preview is a pure
# removal and needs no lock.
if [[ -n "$APPLY_PREVIEW" ]]; then
  sync_apply acquire-lock --root "$DSH_MEMORY_ROOT" --operation-name preview-apply --run-id "$APPLY_PREVIEW" >/dev/null || {
    print -u2 -- "dsh-memory-sync: another memory operation is in progress"
    exit 1
  }
  apply_out="$(sync_apply apply-preview --root "$DSH_MEMORY_ROOT" --run-id "$APPLY_PREVIEW" --operation-name preview --started-at "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" || {
    apply_error="$(printf '%s' "$apply_out" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["error"]["code"])' 2>/dev/null || echo preview-apply-failed)"
    sync_apply release-lock --root "$DSH_MEMORY_ROOT" --run-id "$APPLY_PREVIEW" >/dev/null 2>&1 || true
    print -u2 -- "dsh-memory-sync: preview apply failed: $apply_error"
    exit 1
  }
  sync_apply remove-preview --root "$DSH_MEMORY_ROOT" --run-id "$APPLY_PREVIEW" >/dev/null 2>&1 || true
  sync_apply release-lock --root "$DSH_MEMORY_ROOT" --run-id "$APPLY_PREVIEW" >/dev/null 2>&1 || true
  echo "dsh-memory-sync: preview $APPLY_PREVIEW applied."
  exit 0
fi
if [[ -n "$DISCARD_PREVIEW" ]]; then
  discard_out="$(sync_apply remove-preview --root "$DSH_MEMORY_ROOT" --run-id "$DISCARD_PREVIEW")" || {
    print -u2 -- "dsh-memory-sync: preview discard failed: preview not found"
    exit 1
  }
  removed="$(printf '%s' "$discard_out" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["value"]["removed"])' 2>/dev/null || echo false)"
  if [[ "$removed" != "True" ]]; then
    print -u2 -- "dsh-memory-sync: preview discard failed: preview not found"
    exit 1
  fi
  echo "dsh-memory-sync: preview $DISCARD_PREVIEW discarded."
  exit 0
fi

# Zero-cost guard: nothing new since the last sync exits before any DSH run.
typeset -a CANDIDATE_FILES
CANDIDATE_FILES=()
if [[ -f "$MARKER" ]]; then
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] && CANDIDATE_FILES+=("$candidate")
  done < <(find "$DSH_HOME/sessions" -name 'session.jsonl.zstd' -newer "$MARKER" ! -newermt '-1 hour' -print 2>/dev/null | sort)
  # A capped batch intentionally leaves the watermark unchanged. Re-add the
  # pending paths on the next run, then filter hashes already delivered so a
  # new session cannot cause the previous batch to be sent to the provider a
  # second time.
  while IFS=$'\t' read -r pending_path pending_digest; do
    [[ -n "$pending_path" && -f "$pending_path" ]] || continue
    [[ "$(find "$pending_path" -newermt '-1 hour' -print -quit 2>/dev/null)" == "" ]] || continue
    already_listed=0
    for candidate in "${CANDIDATE_FILES[@]}"; do
      [[ "$candidate" == "$pending_path" ]] && already_listed=1 && break
    done
    (( already_listed == 1 )) || CANDIDATE_FILES+=("$pending_path")
  done < <(pending_candidate_lines)
  typeset -a UNPROCESSED_CANDIDATES
  UNPROCESSED_CANDIDATES=()
  for candidate in "${CANDIDATE_FILES[@]}"; do
    candidate_hash="$(candidate_file_digest "$candidate")"
    if pending_candidate_digest "$candidate" "$candidate_hash"; then
      continue
    fi
    UNPROCESSED_CANDIDATES+=("$candidate")
  done
  CANDIDATE_FILES=("${UNPROCESSED_CANDIDATES[@]}")
  typeset -a LIMITED_CANDIDATES
  LIMITED_CANDIDATES=()
  for candidate in "${CANDIDATE_FILES[@]}"; do
    local_size="$(stat -f %z -- "$candidate" 2>/dev/null || print 0)"
    if (( local_size > MAX_CANDIDATE_BYTES )); then
      CANDIDATE_LIMIT_ERROR="candidate-too-large"
      break
    fi
    if (( ${#LIMITED_CANDIDATES} >= MAX_CANDIDATE_SESSIONS )); then
      CANDIDATE_TRUNCATED=1
      break
    fi
    if (( CANDIDATE_BYTES + local_size > MAX_CANDIDATE_BYTES )); then
      CANDIDATE_TRUNCATED=1
      break
    fi
    LIMITED_CANDIDATES+=("$candidate")
    CANDIDATE_BYTES=$((CANDIDATE_BYTES + local_size))
  done
  CANDIDATE_FILES=("${LIMITED_CANDIDATES[@]}")
  CANDIDATE_SESSIONS=${#CANDIDATE_FILES}
  CANDIDATE_DIGEST="$(candidate_digest "${CANDIDATE_FILES[@]}")"
  if [[ -n "$CANDIDATE_LIMIT_ERROR" ]]; then
    progress "candidate batch rejected: $CANDIDATE_LIMIT_ERROR"
  elif [[ "$CANDIDATE_SESSIONS" == "0" ]]; then
    [[ "$DRY_RUN" == "0" && "$PREVIEW_MODE" == "0" ]] && rm -f -- "$PENDING_CANDIDATES"
    if [[ "$DRY_RUN" == "1" ]]; then
      if [[ "$JSON_OUTPUT" == "1" ]]; then
        printf '{"ok":true,"dryRun":true,"candidateSessions":0,"changedPaths":[],"message":"no new idle session logs"}\n'
      else
        echo "dsh-memory-sync: dry-run: no new idle session logs since $(stat -f '%Sm' "$MARKER"), nothing to do."
      fi
    else
      echo "dsh-memory-sync: no new idle session logs since $(stat -f '%Sm' "$MARKER"), nothing to do."
    fi
    exit 0
  fi
  progress "$CANDIDATE_SESSIONS new idle session log(s), starting headless consolidation…"
else
  progress "first run — marker will be created, historical sessions skipped."
fi

DSH_EXECUTABLE="$(command -v -- "$DSH_BIN" 2>/dev/null || true)"
if [[ -z "$DSH_EXECUTABLE" || ! -x "$DSH_EXECUTABLE" ]]; then
  print -u2 -- "dsh-memory-sync: DSH executable not found or not executable: $DSH_BIN"
  print -u2 -- "dsh-memory-sync: install DSH separately or set DSH_BIN to an executable path."
  exit 127
fi

[[ -f "$SYNC_APPLY" ]] || { print -u2 -- "dsh-memory-sync: sync helper is missing: $SYNC_APPLY"; exit 127; }

START_TS=$(date +%s)
RUN_ID=$(date -u +%Y%m%dT%H%M%SZ)-$(/usr/bin/uuidgen | tr '[:upper:]' '[:lower:]' | tr -d '-' | cut -c1-8)
STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
CANDIDATE_MANIFEST_TMP=""

# v0.3: serialize sync runs with a host-side operation lock and record the
# active run so an interrupted process can be recovered on the next sync.
# Dry-run is read-only and must not create .sync, so the lock is only taken
# when a real apply can happen.
LOCK_HELD=0
cleanup_sync_operation() {
  if [[ "$LOCK_HELD" == "1" ]]; then
    sync_apply clear-active --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" >/dev/null 2>&1 || true
    sync_apply release-lock --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" >/dev/null 2>&1 || true
  fi
  [[ -n "$CANDIDATE_MANIFEST_TMP" ]] && rm -f -- "$CANDIDATE_MANIFEST_TMP"
}
trap cleanup_sync_operation EXIT

if [[ "$DRY_RUN" == "0" ]]; then
  lock_output=""
  if ! lock_output="$(sync_apply acquire-lock --root "$DSH_MEMORY_ROOT" --operation-name sync --run-id "$RUN_ID")"; then
    sync_apply lock-rejection --root "$DSH_MEMORY_ROOT" --operation-name sync --run-id "$RUN_ID" \
      --error-code operation-in-progress >/dev/null 2>&1 || true
    print -u2 -- "dsh-memory-sync: another sync operation is in progress"
    exit 1
  fi
  LOCK_HELD=1
  if [[ "$RETRY_FAILED" == "0" && -n "$CANDIDATE_DIGEST" ]]; then
    retry_output="$(sync_apply retry-check --root "$DSH_MEMORY_ROOT" --candidate-digest "$CANDIDATE_DIGEST" \
      --sync-policy-version "$SYNC_POLICY_VERSION" --cooldown-seconds "$RETRY_COOLDOWN_SECONDS")"
    if [[ "$(printf '%s' "$retry_output" | "$PYTHON_BIN" -c 'import json,sys; print(str(json.load(sys.stdin).get("value", {}).get("suppressed", False)).lower())')" == "true" ]]; then
      retry_error="$(printf '%s' "$retry_output" | "$PYTHON_BIN" -c 'import json,sys; print(json.load(sys.stdin).get("value", {}).get("error_code") or "sync-failed")')"
      sync_apply journal --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" --operation-name sync \
        --status skipped-retry --started-at "$STARTED_AT" --candidate-sessions "$CANDIDATE_SESSIONS" \
        --processed-sessions 0 --skipped-sessions "$CANDIDATE_SESSIONS" --changed-paths "" \
        --error-code "$retry_error" --phase retry --candidate-digest "$CANDIDATE_DIGEST" \
        --sync-policy-version "$SYNC_POLICY_VERSION" --suppress-last-run >/dev/null 2>&1 || true
      print -u2 -- "dsh-memory-sync: retry suppressed for $CANDIDATE_DIGEST"
      exit 0
    fi
  fi
  # A previous sync may have been interrupted (dead pid + active-run record).
  # Recover it into the journal before starting a fresh run.
  recover_output="$(sync_apply recover-active --root "$DSH_MEMORY_ROOT")" || {
    print -u2 -- "dsh-memory-sync: active run recovery failed: $recover_output"
    exit 1
  }
  recovered="$(printf '%s' "$recover_output" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["value"]["recovered"])')"
  if [[ "$recovered" == "True" ]]; then
    progress "recovered an interrupted run; see the run journal."
  fi
  sync_apply write-active --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" --operation-name sync \
    --phase staging --started-at "$STARTED_AT" >/dev/null
fi

if [[ -n "$CANDIDATE_LIMIT_ERROR" ]]; then
  if [[ "$DRY_RUN" == "1" ]]; then
    if [[ "$JSON_OUTPUT" == "1" ]]; then
      printf '{"ok":false,"dryRun":true,"error":{"code":"%s"}}\n' "$CANDIDATE_LIMIT_ERROR"
    else
      print -u2 -- "dsh-memory-sync: candidate batch rejected: $CANDIDATE_LIMIT_ERROR"
    fi
  else
    write_failure_record "$CANDIDATE_LIMIT_ERROR" candidate-scan
    print -u2 -- "dsh-memory-sync: candidate batch rejected: $CANDIDATE_LIMIT_ERROR"
  fi
  exit 1
fi

# --- Transaction setup: an isolated staging worktree + baseline manifest ---
STAGING_PARENT="${TMPDIR:-/tmp}/dsh-memory-sync-$$"
STAGING="$STAGING_PARENT/staging"
MANIFEST="$STAGING_PARENT/manifest.json"
HEADLESS_SESSION_ROOT="$STAGING_PARENT/headless-sessions"
HEADLESS_SESSION_PATCH="$STAGING_PARENT/headless-session.patch.yml"
SANITIZED_INPUT_ROOT="$STAGING/.dsh-memory-inputs"
CANDIDATE_MANIFEST_TMP="$STAGING/.dsh-memory-candidates.txt"
mkdir -p "$STAGING_PARENT"
umask 077

apply_output=""
if ! apply_output="$(sync_apply stage-copy --root "$DSH_MEMORY_ROOT" --staging "$STAGING" --manifest "$MANIFEST" --run-id "$RUN_ID")"; then
  apply_error="$(json_error_code "$apply_output")"
  write_failure_record "$apply_error" staging "$apply_output"
  print -u2 -- "dsh-memory-sync: staging copy failed: $apply_error"
  rm -rf -- "$STAGING_PARENT"
  exit 1
fi

# Host-side input isolation: the model receives only redacted transcripts in
# the staging directory. It never receives the real session paths or the live
# memory root, and the temporary input tree is removed before diff validation.
FILTER_SESSION="$DSH_MEMORY_ROOT/scripts/filter_session.py"
if [[ "${#CANDIDATE_FILES}" -gt 0 && ! -x "$FILTER_SESSION" ]]; then
  write_failure_record "input-filter-unavailable" staging
  print -u2 -- "dsh-memory-sync: session filter not found or not executable"
  rm -rf -- "$STAGING_PARENT"
  exit 1
fi
mkdir -m 700 -p "$SANITIZED_INPUT_ROOT"
: > "$CANDIDATE_MANIFEST_TMP"
FILTER_ERROR_TMP="$STAGING_PARENT/filter-error.txt"
if [[ "${#CANDIDATE_FILES}" -gt 0 ]]; then
  input_index=0
  for candidate in "${CANDIDATE_FILES[@]}"; do
    input_name="$(printf 'session-%04d.md' "$input_index")"
    input_path="$SANITIZED_INPUT_ROOT/$input_name"
    : > "$FILTER_ERROR_TMP"
    if ! "$PYTHON_BIN" "$FILTER_SESSION" "$candidate" > "$input_path" 2>"$FILTER_ERROR_TMP"; then
      filter_error_code="input-filter-failed"
      if grep -q -- '^zstd-unavailable:' "$FILTER_ERROR_TMP"; then
        filter_error_code="zstd-unavailable"
      fi
      write_failure_record "$filter_error_code" staging
      print -u2 -- "dsh-memory-sync: failed to filter a candidate session: $filter_error_code"
      rm -rf -- "$STAGING_PARENT"
      exit 1
    fi
    chmod 600 "$input_path"
    print -r -- "$input_path" >> "$CANDIDATE_MANIFEST_TMP"
    input_index=$((input_index + 1))
  done
fi

# The rc.7 headless bundle deliberately persists every one-shot session. If
# it uses the normal DSH_HOME, each memory consolidation appears in the Web
# session list and must be archived manually. Keep the DSH home (settings,
# profiles, runtime, and credentials policy) unchanged, but route only this
# child session backend to the per-run private directory. The directory lives
# under STAGING_PARENT and is removed with the rest of the transaction.
cat > "$HEADLESS_SESSION_PATCH" <<EOF
- id: session-persistence-jsonl
  config:
    root: $HEADLESS_SESSION_ROOT
EOF
chmod 600 "$HEADLESS_SESSION_PATCH"

# Headless DSH writes only to the staging payload. It never sees the live
# memory root, never runs Git, and never advances the watermark.
STAGING_PROMPT="你是 dsh-memory 的定时记忆整合代理，现在执行一次增量同步。重要：本会话自身绝不提取、绝不整合，避免自我循环。

你在一个隔离的暂存记忆仓库中工作（$STAGING，git 版本化；宪法、「提炼与整合」一节的要求、硬规则见其 README.md，先读它）。你只能修改 $STAGING 下的 summary.md、handbook/、rollouts/、archive/；禁止修改 $STAGING/README.md，禁止创建其他文件或目录，禁止执行任何 git 命令。

宿主已在本地完成候选筛选和凭据脱敏。你只能读取临时脱敏转录，不能访问原始会话日志、真实 DSH_HOME 或真实记忆库。

候选会话清单：$CANDIDATE_MANIFEST_TMP（每行是 staging 内的临时脱敏转录；宿主已按每轮最多 $MAX_CANDIDATE_SESSIONS 个会话、总输入最多 $MAX_CANDIDATE_BYTES 字节截断；只处理清单中的路径）。

步骤：
1. 逐行读取候选会话清单中的临时脱敏转录，按 README「提炼与整合」一节的提炼要求提炼（无高信号则输出 NO_SIGNAL 并跳过该会话）。
3. 全部提炼完成后，严格按 README「提炼与整合」一节的整合要求执行 diff 式整合：与旧条目矛盾的内容覆盖旧条目（绝不叠加）、过时内容降级到 $STAGING/archive/、用户稳定偏好同步进 $STAGING/summary.md。summary.md 最终必须不超过 12 KiB；超出时压缩重复过程和细节，不得静默超过预算。
4. 不要执行 git、不要更新同步水位；宿主会负责提交和记录。

收尾用一句话汇报：处理了几个会话、合并了几条记忆。"

# Start from an empty environment and rebuild only the operational minimum.
# Provider credentials are opt-in by variable name; values are never parsed,
# printed, or copied into the prompt by this wrapper.
typeset -a CHILD_ENV
CHILD_ENV=(
  "${BASE_ENV[@]}"
  "DSH_PERMISSION_MODE=$DSH_PERMISSION_MODE"
  "DSH_TELEMETRY_DISABLED=1"
)

typeset provider_env_names="${DSH_MEMORY_PROVIDER_ENV_NAMES:-}"
for env_name in ${=provider_env_names}; do
  if [[ ! "$env_name" =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]; then
    print -u2 -- "dsh-memory-sync: invalid provider environment variable name: $env_name"
    exit 2
  fi
  if [[ -v "$env_name" ]]; then
    CHILD_ENV+=("$env_name=${(P)env_name}")
  fi
done

# Run the model inside the staging worktree so its relative writes land there.
child_status=0
(
  cd "$STAGING"
  /usr/bin/env -i "${CHILD_ENV[@]}" "$DSH_EXECUTABLE" --profile headless \
    --patch "$HEADLESS_SESSION_PATCH" "$STAGING_PROMPT"
 ) || child_status=$?
# The temporary transcript tree is host-owned input, not memory payload.
rm -rf -- "$SANITIZED_INPUT_ROOT"
rm -f -- "$CANDIDATE_MANIFEST_TMP"
if [[ "$child_status" != "0" ]]; then
  write_failure_record "child-exit" staging
  print -u2 -- "dsh-memory-sync: headless DSH failed with exit code $child_status"
  rm -rf -- "$STAGING_PARENT"
  exit "$child_status"
fi
# The process exited successfully, so every eligible log was delivered to
# headless DSH. Per-session NO_SIGNAL results are deliberately not guessed from
# model prose and therefore do not change the host-side skipped count.
PROCESSED_SESSIONS="$CANDIDATE_SESSIONS"

# --- Host-side verification and apply ---
if [[ "$DRY_RUN" == "0" ]]; then
  sync_apply write-active --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" --operation-name sync \
    --phase validating --started-at "$STARTED_AT" >/dev/null
fi
difference=""
if ! difference="$(sync_apply diff --staging "$STAGING" --manifest "$MANIFEST" --run-id "$RUN_ID")"; then
  diff_error="$(json_error_code "$difference")"
  write_failure_record "$diff_error" validating "$difference"
  print -u2 -- "dsh-memory-sync: staging diff failed: $diff_error"
  rm -rf -- "$STAGING_PARENT"
  exit 1
fi

changed_paths="$(printf '%s' "$difference" | /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin)["value"]; print(",".join(sorted(d["added"]+d["modified"]+d["deleted"])))')"
diff_added="$(printf '%s' "$difference" | /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin)["value"]; print(",".join(sorted(d["added"])))')"
diff_modified="$(printf '%s' "$difference" | /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin)["value"]; print(",".join(sorted(d["modified"])))')"
diff_deleted="$(printf '%s' "$difference" | /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin)["value"]; print(",".join(sorted(d["deleted"])))')"
diff_bytes="$(printf '%s' "$difference" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["value"].get("changed_bytes", 0))')"
json_list() { [[ -z "$1" ]] && printf '[]' || printf '[%s]' "$(printf '%s' "$1" | /usr/bin/sed 's/\([^,]*\)/"\1"/g')"; }

if [[ -z "$changed_paths" ]]; then
  if [[ "$DRY_RUN" == "1" && "$JSON_OUTPUT" == "1" ]]; then
    printf '{"ok":true,"dryRun":true,"candidateSessions":%s,"changedPaths":[],"message":"no changes"}\n' "$CANDIDATE_SESSIONS"
  else
    echo "dsh-memory-sync: no memory changes, nothing to apply."
    if [[ "$DRY_RUN" == "1" ]]; then
      echo "dsh-memory-sync: dry-run: no changes would be applied."
    fi
  fi
  # Zero-change runs still advance the watermark and journal a no_change
  # record: every candidate was delivered to the model, so rescanning the
  # same window forever would only repeat paid model calls. The run did not
  # touch the live payload, so finalize commits only .sync + .last-sync.
  # Preview runs are excluded: preview mode is an operator-review tool and
  # stays non-journaling (see the preview contract comment near the end).
  if [[ "$DRY_RUN" == "0" && "$PREVIEW_MODE" == "0" ]]; then
    typeset -a FINALIZE_LAST_SYNC_ARGS
    FINALIZE_LAST_SYNC_ARGS=()
    [[ "$CANDIDATE_TRUNCATED" == "1" ]] || FINALIZE_LAST_SYNC_ARGS=(--last-sync "$START_TS")
    DURATION_MS=$(( ( $(date +%s) - START_TS ) * 1000 ))
    finalize_output=""
    if ! finalize_output="$(sync_apply finalize \
      --root "$DSH_MEMORY_ROOT" \
      --run-id "$RUN_ID" \
      --operation-name sync \
      --status no_change \
      --started-at "$STARTED_AT" \
      --candidate-sessions "$CANDIDATE_SESSIONS" \
      --processed-sessions "$PROCESSED_SESSIONS" \
      --skipped-sessions "$SKIPPED_SESSIONS" \
      --changed-paths "" \
      --phase complete \
      --duration-ms "$DURATION_MS" \
      --candidate-digest "$CANDIDATE_DIGEST" \
      --sync-policy-version "$SYNC_POLICY_VERSION" \
      "${FINALIZE_LAST_SYNC_ARGS[@]}")"; then
      sync_apply write-finalize-failure --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" \
        --candidate-digest "$CANDIDATE_DIGEST" >/dev/null 2>&1 || true
      print -u2 -- "dsh-memory-sync: finalize failed"
      exit 1
    fi
    write_pending_candidates
    sync_apply clear-failure-sentinel --root "$DSH_MEMORY_ROOT" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$STAGING_PARENT"
  exit 0
fi

if [[ "$DRY_RUN" == "1" ]]; then
  if [[ "$JSON_OUTPUT" == "1" ]]; then
    printf '{"ok":true,"dryRun":true,"candidateSessions":%s,"changedPaths":%s,"added":%s,"modified":%s,"deleted":%s,"changedBytes":%s}\n' \
      "$CANDIDATE_SESSIONS" "$(json_list "$changed_paths")" "$(json_list "$diff_added")" "$(json_list "$diff_modified")" "$(json_list "$diff_deleted")" "$diff_bytes"
  else
    echo "dsh-memory-sync: dry-run — would apply: $changed_paths"
  fi
  rm -rf -- "$STAGING_PARENT"
  exit 0
fi

# --- Preview mode: stage the candidate diff under .sync/previews/<id> and
# leave it pending. Nothing is applied, journaled, or committed here; the
# model edit is captured so an operator can review and apply it later.
if [[ "$PREVIEW_MODE" == "1" ]]; then
  sync_apply prepare-preview --root "$DSH_MEMORY_ROOT" --run-id "$PREVIEW_ID" >/dev/null || {
    print -u2 -- "dsh-memory-sync: preview prepare failed"
    rm -rf -- "$STAGING_PARENT"
    exit 1
  }
  preview_root="$DSH_MEMORY_ROOT/.sync/previews/$PREVIEW_ID"
  # Copy the staged payload (baseline + model edits) into the preview staging.
  rm -rf -- "$preview_root/staging"
  cp -R -- "$STAGING" "$preview_root/staging"
  chmod -R 700 "$preview_root/staging" 2>/dev/null || true
  PREVIEW_EXPIRES=$(date -u -v+7d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '+7 days' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)
  preview_meta="{\"preview_id\":\"$PREVIEW_ID\",\"created_at\":\"$STARTED_AT\",\"expires_at\":\"$PREVIEW_EXPIRES\",\"candidate_sessions\":$CANDIDATE_SESSIONS,\"changed_paths\":[$(printf '%s' "$changed_paths" | /usr/bin/sed 's/\([^,]*\)/"\1"/g')],\"status\":\"pending\"}"
  sync_apply write-preview --root "$DSH_MEMORY_ROOT" --run-id "$PREVIEW_ID" --preview-json "$preview_meta" >/dev/null || {
    print -u2 -- "dsh-memory-sync: preview write failed"
    rm -rf -- "$STAGING_PARENT"
    exit 1
  }
  echo "dsh-memory-sync: preview $PREVIEW_ID created (pending, expires $PREVIEW_EXPIRES)."
  echo "dsh-memory-sync: changed: $changed_paths"
  rm -rf -- "$STAGING_PARENT"
  exit 0
fi

if [[ "$DRY_RUN" == "0" ]]; then
  sync_apply write-active --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" --operation-name sync \
    --phase applying --started-at "$STARTED_AT" >/dev/null
fi
apply_result="$(sync_apply apply --root "$DSH_MEMORY_ROOT" --staging "$STAGING" --manifest "$MANIFEST" --run-id "$RUN_ID" --started-at "$STARTED_AT")" || {
  apply_error="$(json_error_code "$apply_result")"
  # Record the failure in the journal so the run is auditable even when the
  # apply itself did not commit anything.
  write_failure_record "$apply_error" applying "$apply_result"
  print -u2 -- "dsh-memory-sync: apply failed: $apply_result"
  rm -rf -- "$STAGING_PARENT"
  exit 1
}

recovery_commit="$(printf '%s' "$apply_result" | /usr/bin/python3 -c 'import json,sys; v=json.load(sys.stdin)["value"]; print(v.get("recovery_commit") or "")')"
apply_commit="$(printf '%s' "$apply_result" | /usr/bin/python3 -c 'import json,sys; v=json.load(sys.stdin)["value"]; print(v.get("apply_commit") or "")')"

# Journal the run and advance the watermark only after a successful apply.
DURATION_MS=$(( ( $(date +%s) - START_TS ) * 1000 ))
if [[ "$DRY_RUN" == "0" ]]; then
  sync_apply write-active --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" --operation-name sync \
    --phase finalizing --started-at "$STARTED_AT" >/dev/null
fi
finalize_output=""
typeset -a FINALIZE_LAST_SYNC_ARGS
FINALIZE_LAST_SYNC_ARGS=()
[[ "$CANDIDATE_TRUNCATED" == "1" ]] || FINALIZE_LAST_SYNC_ARGS=(--last-sync "$START_TS")
if ! finalize_output="$(sync_apply finalize \
  --root "$DSH_MEMORY_ROOT" \
  --run-id "$RUN_ID" \
  --operation-name sync \
  --status applied \
  --started-at "$STARTED_AT" \
  --candidate-sessions "$CANDIDATE_SESSIONS" \
  --processed-sessions "$PROCESSED_SESSIONS" \
  --changed-paths "$changed_paths" \
  --recovery-commit "$recovery_commit" \
  --apply-commit "$apply_commit" \
  --phase complete \
  --duration-ms "$DURATION_MS" \
  --candidate-digest "$CANDIDATE_DIGEST" \
  --sync-policy-version "$SYNC_POLICY_VERSION" \
  "${FINALIZE_LAST_SYNC_ARGS[@]}")"; then
  sync_apply write-finalize-failure --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" \
    --candidate-digest "$CANDIDATE_DIGEST" >/dev/null 2>&1 || true
  print -u2 -- "dsh-memory-sync: finalize failed"
  rm -rf -- "$STAGING_PARENT"
  exit 1
fi
write_pending_candidates
sync_apply clear-failure-sentinel --root "$DSH_MEMORY_ROOT" >/dev/null 2>&1 || true

if [[ "$DRY_RUN" == "0" ]]; then
  sync_apply clear-active --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" >/dev/null 2>&1 || true
  sync_apply release-lock --root "$DSH_MEMORY_ROOT" --run-id "$RUN_ID" >/dev/null 2>&1 || true
  LOCK_HELD=0
fi

echo "dsh-memory-sync: applied $changed_paths (recovery $recovery_commit, apply $apply_commit, run $RUN_ID)."
rm -rf -- "$STAGING_PARENT"
