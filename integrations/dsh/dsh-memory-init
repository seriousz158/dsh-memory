#!/bin/zsh
set -euo pipefail

if [[ -z "${DSH_MEMORY_INIT_SANITIZED:-}" ]]; then
  typeset -a init_env
  typeset locale_name locale_value
  init_env=(env -i "DSH_MEMORY_INIT_SANITIZED=1" "HOME=$HOME" "PATH=$PATH")

  for locale_name in LC_ALL LC_COLLATE LC_CTYPE LC_MESSAGES LC_MONETARY LC_NUMERIC LC_TIME; do
    locale_value="${(P)locale_name-}"
    [[ -n "$locale_value" ]] && init_env+=("${locale_name}=${locale_value}")
  done
  [[ -n "${TMPDIR:-}" ]] && init_env+=("TMPDIR=$TMPDIR")
  [[ -n "${LANG:-}" ]] && init_env+=("LANG=$LANG")
  [[ -n "${DSH_HOME:-}" ]] && init_env+=("DSH_HOME=$DSH_HOME")
  [[ -n "${DSH_MEMORY_ROOT:-}" ]] && init_env+=("DSH_MEMORY_ROOT=$DSH_MEMORY_ROOT")

  exec "${init_env[@]}" "$0" "$@"
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
REPOSITORY_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd -P)"
DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
MEMORY_ROOT="${DSH_MEMORY_ROOT:-$DSH_HOME/storages/memory}"
TEMPLATE_ROOT="$REPOSITORY_ROOT/packages/dsh-memory/templates"

die() {
  print -u2 -- "dsh-memory-init: $*"
  exit 1
}

[[ "$DSH_HOME" = /* ]] || die "DSH_HOME must be an absolute path"
[[ "$MEMORY_ROOT" = /* ]] || die "DSH_MEMORY_ROOT must be an absolute path"
[[ -d "$TEMPLATE_ROOT" && ! -L "$TEMPLATE_ROOT" ]] || die "memory templates are unavailable"
[[ -f "$TEMPLATE_ROOT/README.md" && ! -L "$TEMPLATE_ROOT/README.md" ]] || die "memory README template is unavailable"
[[ -f "$TEMPLATE_ROOT/.sync/.gitignore" && ! -L "$TEMPLATE_ROOT/.sync/.gitignore" ]] || die "sync ignore template is unavailable"
[[ -f "$TEMPLATE_ROOT/scripts/filter_session.py" && ! -L "$TEMPLATE_ROOT/scripts/filter_session.py" ]] || die "session filter template is unavailable"

git_bin="$(command -v git)" || die "git is required"
install_bin="$(command -v install)" || die "install is required"
umask 077

validate_initialized_repository() {
  local required_path
  local required_directory

  [[ -d "$MEMORY_ROOT/.git" && ! -L "$MEMORY_ROOT/.git" ]] || return 1
  "$git_bin" -C "$MEMORY_ROOT" rev-parse --verify HEAD >/dev/null 2>&1 || return 1
  for required_path in README.md summary.md .last-sync .sync/.gitignore scripts/filter_session.py; do
    [[ -f "$MEMORY_ROOT/$required_path" && ! -L "$MEMORY_ROOT/$required_path" ]] || return 1
  done
  for required_directory in handbook rollouts archive scripts .sync; do
    [[ -d "$MEMORY_ROOT/$required_directory" && ! -L "$MEMORY_ROOT/$required_directory" ]] || return 1
  done
  [[ -x "$MEMORY_ROOT/scripts/filter_session.py" ]] || return 1
}

harden_initialized_repository() {
  chmod 700 \
    "$MEMORY_ROOT" \
    "$MEMORY_ROOT/.git" \
    "$MEMORY_ROOT/handbook" \
    "$MEMORY_ROOT/rollouts" \
    "$MEMORY_ROOT/archive" \
    "$MEMORY_ROOT/.sync" \
    "$MEMORY_ROOT/scripts"
  chmod 600 \
    "$MEMORY_ROOT/README.md" \
    "$MEMORY_ROOT/summary.md" \
    "$MEMORY_ROOT/.last-sync" \
    "$MEMORY_ROOT/.sync/.gitignore"
  chmod 700 "$MEMORY_ROOT/scripts/filter_session.py"
}

refresh_helper_script() {
  local helper_path="$MEMORY_ROOT/scripts/filter_session.py"
  local helper_status
  local temporary_path

  helper_status="$($git_bin -C "$MEMORY_ROOT" status --porcelain --untracked-files=all -- scripts/filter_session.py)"
  [[ -z "$helper_status" ]] || die "refusing to refresh a dirty memory helper"
  cmp -s "$TEMPLATE_ROOT/scripts/filter_session.py" "$helper_path" && return 0

  temporary_path="$(/usr/bin/mktemp "$MEMORY_ROOT/scripts/.filter_session.py.XXXXXX")"
  if ! "$install_bin" -m 700 "$TEMPLATE_ROOT/scripts/filter_session.py" "$temporary_path"; then
    rm -f -- "$temporary_path"
    die "could not stage the refreshed memory helper"
  fi
  mv -f -- "$temporary_path" "$helper_path"
  chmod 700 "$helper_path"
  "$git_bin" -C "$MEMORY_ROOT" add -- scripts/filter_session.py
  "$git_bin" -C "$MEMORY_ROOT" commit --quiet --only -m "Refresh helper scripts" -- scripts/filter_session.py \
    || die "could not commit the refreshed memory helper"
}

if [[ -e "$MEMORY_ROOT" || -L "$MEMORY_ROOT" ]]; then
  [[ -d "$MEMORY_ROOT" && ! -L "$MEMORY_ROOT" ]] || die "refusing a non-directory or symlink memory root"
  if "$git_bin" -C "$MEMORY_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    root_real="$(cd -- "$MEMORY_ROOT" && pwd -P)"
    top_path="$("$git_bin" -C "$MEMORY_ROOT" rev-parse --show-toplevel)"
    top_real="$(cd -- "$top_path" && pwd -P)"
    [[ "$root_real" == "$top_real" ]] || die "memory root must be the Git worktree root"
    if [[ ! -e "$MEMORY_ROOT/.sync" ]]; then
      mkdir -p "$MEMORY_ROOT/.sync"
      "$install_bin" -m 600 "$TEMPLATE_ROOT/.sync/.gitignore" "$MEMORY_ROOT/.sync/.gitignore"
    elif [[ ! -d "$MEMORY_ROOT/.sync" || -L "$MEMORY_ROOT/.sync" ]]; then
      die "memory .sync path is unsafe"
    elif [[ ! -e "$MEMORY_ROOT/.sync/.gitignore" ]]; then
      "$install_bin" -m 600 "$TEMPLATE_ROOT/.sync/.gitignore" "$MEMORY_ROOT/.sync/.gitignore"
    elif [[ -L "$MEMORY_ROOT/.sync/.gitignore" ]]; then
      die "memory .sync/.gitignore is unsafe"
    fi
    validate_initialized_repository || die "memory root is an incomplete DSH memory repository"
    refresh_helper_script
    harden_initialized_repository || die "could not restore private memory repository permissions"
    print -- "$root_real"
    exit 0
  fi
  [[ -z "$(find "$MEMORY_ROOT" -mindepth 1 -maxdepth 1 -print -quit)" ]] || die "refusing to initialize a non-empty non-Git directory"
else
  mkdir -p "$MEMORY_ROOT"
fi

[[ ! -L "$MEMORY_ROOT" ]] || die "refusing a symlink memory root"
mkdir -p "$MEMORY_ROOT/handbook" "$MEMORY_ROOT/rollouts" "$MEMORY_ROOT/archive" "$MEMORY_ROOT/scripts" "$MEMORY_ROOT/.sync"
chmod 700 "$MEMORY_ROOT" "$MEMORY_ROOT/handbook" "$MEMORY_ROOT/rollouts" "$MEMORY_ROOT/archive" "$MEMORY_ROOT/scripts" "$MEMORY_ROOT/.sync"
"$install_bin" -m 600 "$TEMPLATE_ROOT/README.md" "$MEMORY_ROOT/README.md"
"$install_bin" -m 600 "$TEMPLATE_ROOT/.sync/.gitignore" "$MEMORY_ROOT/.sync/.gitignore"
"$install_bin" -m 700 "$TEMPLATE_ROOT/scripts/filter_session.py" "$MEMORY_ROOT/scripts/filter_session.py"
: > "$MEMORY_ROOT/summary.md"
: > "$MEMORY_ROOT/.last-sync"
chmod 600 "$MEMORY_ROOT/README.md" "$MEMORY_ROOT/summary.md" "$MEMORY_ROOT/.last-sync"

"$git_bin" -C "$MEMORY_ROOT" init --quiet
"$git_bin" -C "$MEMORY_ROOT" config user.name "DPSK Memory"
"$git_bin" -C "$MEMORY_ROOT" config user.email "dpsk-memory@localhost"
"$git_bin" -C "$MEMORY_ROOT" add README.md summary.md .last-sync .sync/.gitignore scripts/filter_session.py
"$git_bin" -C "$MEMORY_ROOT" commit --quiet -m "Initialize DPSK memory repository"
harden_initialized_repository || die "could not set private memory repository permissions"

print -- "$(cd -- "$MEMORY_ROOT" && pwd -P)"
